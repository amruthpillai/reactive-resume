{
	"cli": { "version": ">= 25.2.0", "appVersionSource": "remote", "promptToConfigurePushNotifications": false },
	"build": {
		"base": {
			"node": "24.22.0",
			"pnpm": "12.14.0",
			"env": { "EXPO_NO_TELEMETRY": "1" }
		},
		"development": {
			"extends": "base",
			"environment": "development",
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"extends": "base",
			"environment": "preview",
			"channel": "preview",
			"distribution": "internal"
		},
		"production": {
			"extends": "base",
			"environment": "production",
			"channel": "production",
			"distribution": "store",
			"autoIncrement": true
		}
	},
	"submit": {
		"production": {
			"ios": {
				"appleTeamId": "654ASRW868",
				"ascAppId": "6823975835"
			},
			"android": {
				"track": "internal",
				"releaseStatus": "draft"
			}
		}
	}
}
