{
	"extends": "@reactive-resume/config/tsconfig.base.json",
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", "ios", "android", "dist"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["DOM", "ESNext"],
		"module": "preserve",
		"customConditions": ["react-native"],
		"types": ["node", "expo/types"],
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*"],
			"phosphor-react-native/src/icons/*": ["./src/ui/phosphor-icons.d.ts"]
		}
	}
}
